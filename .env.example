# Telegram Bot 設定
TELEGRAM_BOT_TOKEN=你的 Telegram Bot Token
TELEGRAM_CHAT_ID=你的 Telegram 聊天 ID
ENABLE_NOTIFICATIONS=true

# 套利策略與手續費參數
BASE_AMOUNT=490000
MIN_PROFIT_TWD=1500
MAX_TRADE_FEE_RATE=0.045
UBOT_DISCOUNT=0.035
WITHDRAW_FEE=30
POLLING_INTERVAL_MINUTES=1

# Web 儀表板與安全設定
PORT=3888
DASHBOARD_PASSWORD=

# Cloudflare Zero Trust (Access) 安全設定
# 開啟後會自動讀取 Cloudflare 驗證的 Email，並在儀表板顯示身分 Badge
CF_ACCESS_ENABLED=true
# 限制可存取的 Email 白名單（多個用逗號分隔，留空則允許所有通過 Cloudflare Access 驗證的 Email）
ALLOWED_EMAILS=
